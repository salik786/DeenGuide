# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it's already in .gitignore.

# Anthropic API key, used to call Claude Sonnet for chat answers.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for chat (defaults to claude-sonnet-5).
# ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI API key, used for voice input (Whisper) and voice output (TTS).
# Get one at https://platform.openai.com/
OPENAI_API_KEY=

# Optional: Upstash Redis (Vercel KV), powers /insights (Q&A transcript log +
# thumbs up/down feedback). Provision it via the Upstash integration in your
# Vercel project's Storage tab, then copy the REST URL/token here. Without
# these, the app still works fine — /insights just shows "not configured."
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: shared secret for the /insights page (?key=...). Pick any string.
INSIGHTS_KEY=
